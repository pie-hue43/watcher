# Port des Backends (API, WebSocket und Dashboard)
PORT=3000
# Gemeinsames Geheimnis zwischen Watcher und Backend (bitte ändern!)
WATCHER_TOKEN=bitte-aendern
# Wo der Watcher das Backend erreicht
BACKEND_URL=http://localhost:3000
# Vinted-Länderseite
VINTED_DOMAIN=www.vinted.de
# Sekunden zwischen zwei Durchläufen pro Suchauftrag (nicht unter 30 gehen)
POLL_INTERVAL_SEC=60
# "vinted" für echte Daten, "mock" für Testdaten ohne Vinted
WATCHER_SOURCE=vinted
# Erlaubte Origins für deine eigene Website (kommagetrennt), z. B. https://meine-seite.de
ALLOWED_ORIGINS=
# Pfad zur SQLite-Datenbank
DB_PATH=./data/watcher.db
# AI Tools (optional): Claude für AI Listings, AI Filters und Seller Intel
ANTHROPIC_API_KEY=
# AI Photo Enhancer (optional): Hintergrund entfernen über remove.bg
REMOVE_BG_API_KEY=

# --- Weitere Plattformen (optional) ---
# eBay live über die offizielle Browse API (developer.ebay.com, "Production" Keyset). Ohne Schlüssel: nur Such-Links.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Etsy live über die Open API v3 (etsy.com/developers). Ohne Schlüssel: nur Such-Links.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Alert inbox: Postfach, in dem die Suchauftrag-Mails von Kleinanzeigen ankommen.
# watchr liest dort nur ungelesene Mails von kleinanzeigen.de und markiert sie danach als gelesen.
# Gmail/GMX/Web.de brauchen ein App-Passwort. Port 993 = verschlüsselt.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
